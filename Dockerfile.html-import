# Build/test image only. GitHub Pages receives static files, never this image.
# uv is a build-time tool here: it creates the pytest environment in its own stage and is not
# part of the final image (no pip, no python3-venv, no uv).
FROM ghcr.io/astral-sh/uv:0.13.6 AS uv
FROM node:26-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS tests-venv
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/test-project
COPY pyproject.toml uv.lock ./
RUN UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/tests \
    uv sync --locked --only-group docker-test --python /usr/bin/python3 --no-cache

FROM base
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npx playwright install --with-deps --only-shell chromium webkit
COPY --from=tests-venv /opt/tests /opt/tests
COPY . .
RUN python3 tools/build_html_import.py
ENV PATH="/opt/tests/bin:${PATH}"
CMD ["sh", "-c", "python -m pytest tests/test_html_import.py tests/test_portal_links.py tests/test_lab_publication.py --junitxml=reports/html-import-python.xml && npx playwright test --config playwright/html-import.config.js"]
