{
  "schema": "project-metadata/1",
  "name": "Ironmate",
  "repository": "https://github.com/myon-bioinformatics/Ironmate",
  "summary": "ブラウザの画像・スライド編集、PPTX出力、ドット絵・画像一覧とローカルCLI",
  "status": "prototype_implemented",
  "pptx": {
    "status": "prototype",
    "markdown_to_pptx": {
      "cli": "pptx_pipeline.py",
      "input_modes": [
        "Markdown file",
        "inline --text",
        "stdin -"
      ],
      "requires": [
        "python-pptx",
        "preinstalled Marp CLI"
      ],
      "optional": [
        "Mermaid SVG preprocessing (--mmdc)"
      ],
      "limitations": [
        "Marp-generated slides may not have editable text",
        "visual fidelity is not guaranteed"
      ]
    },
    "existing_pptx_editing": {
      "cli": "pptx_replace.py",
      "supported": [
        "text replacement within each text run",
        "explicit RGB run text color",
        "explicit solid RGB slide background",
        "font family, size, and bold",
        "dry-run and optional TOML rules",
        "new output file without overwriting the original"
      ],
      "unsupported": [
        "text matching across runs",
        "theme/inherited text colors and slide backgrounds",
        "grouped shapes, tables, notes, and masters",
        "arrow attributes and advanced formatting"
      ]
    }
  },
  "plan": "https://github.com/myon-bioinformatics/Ironmate/issues/80",
  "pixel_prototype": "https://github.com/myon-bioinformatics/Ironmate/pull/79",
  "adapter_transfer": "https://github.com/myon-bioinformatics/mcp-toolcall-lab/pull/108",
  "browser_tools": {
    "studio": "https://myon-bioinformatics.github.io/Ironmate/",
    "workbench": "https://myon-bioinformatics.github.io/Ironmate/tools/",
    "processing": "browser-local",
    "features": [
      "image composition and heatmap/mosaic",
      "PNG/SVG/JSON/Base64 export",
      "procedural pixel-grid presets and nearest resizing",
      "image contact sheet PNG and self-contained HTML",
      "exact Base64 capacity calculation",
      "multiple slides with editable text, shapes and triangle arrows exported as PPTX"
    ],
    "slides": "https://myon-bioinformatics.github.io/Ironmate/slides/"
  }
}
